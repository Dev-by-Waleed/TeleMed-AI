# TeleMed AI — environment variables
# Copy to `.env` and fill in your Supabase project values.

# Supabase (public — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site origin used in auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI report summarization (Gemini 1.5 Flash). Leave empty to keep reports "uploaded".
GEMINI_API_KEY=

# Server-only secret; required for admin "create doctor" and invite activation.
# Find it in Supabase Dashboard > Settings > API (service_role key).
SUPABASE_SERVICE_ROLE_KEY=
